    <tbody>
    <% rows.forEach(function (r) { %>
      <tr><td><strong><%= r[0] %></strong></td><td><%= r[1] %></td><td><%= r[2] %></td><td><%= r[3] %></td><td class="mono small"><%= r[4] %></td></tr>
    <% }) %>
    </tbody>
  </table>
</section>
<%- include('partials/footer') %>
